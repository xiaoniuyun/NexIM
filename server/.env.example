# 公网部署环境变量示例：复制为 .env 后按实际服务器修改（docker compose 会自动加载）
# Copy-Item .env.example .env

# 服务器公网 IP 或域名：客户端通过该地址访问 STUN/TURN，必须是外网可达地址
TURN_EXTERNAL_IP=203.0.113.10

# TURN 长期凭证认证（务必替换默认密码）
TURN_REALM=nex.im
TURN_USER=nexim
TURN_PASS=change-me-strong-password

# 可选：显式覆盖 ICE 地址（多 STUN 节点用逗号分隔）
# STUN_SERVERS=stun:203.0.113.10:3478
# TURN_URL=turn:203.0.113.10:3478?transport=udp
