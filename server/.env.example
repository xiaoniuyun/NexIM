# 复制为 server/.env 后按部署环境修改（docker compose 自动读取）
# 跨设备/公网部署：填客户端可访问的宿主内网 IP 或公网 IP/域名
# 单机调试可改为 127.0.0.1（此时仅本机客户端可走 TURN 中继）
TURN_EXTERNAL_IP=192.168.1.10

# TURN 账号（需与客户端下发的一致）
TURN_REALM=nex.im
TURN_USER=nexim
TURN_PASS=nexim123

# 可选：显式覆盖下发给客户端的 ICE 地址（多 STUN 用逗号分隔）
# STUN_SERVERS=stun:192.168.1.10:3478
# TURN_URL=turn:192.168.1.10:3478?transport=udp
